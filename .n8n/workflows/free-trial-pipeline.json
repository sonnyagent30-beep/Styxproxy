              "options": {
                "caseSensitive": false,
                "leftValue": "",
                "typeValidation": "loose"
              },
              "conditions": [
                {
                  "id": "cond-slot-ok",
                  "leftValue": "={{$json.port}}",
                  "rightValue": 0,
                  "operator": {
                    "type": "number",
                    "operation": "gt"
                  }
                }
              ]
            }
          }
        ],
        "outputCount": 1,
        "fallbackOutput": "extra"
      }
