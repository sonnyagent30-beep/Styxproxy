        "conditions": "status = 'fulfilled' AND provider = 'DataImpulse' AND data_remaining_gb > 0"
      },
      "id": "da-query",
      "name": "Query Active DataImpulse Orders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1790,
        300
