"""Page-aware prompt templates for Charon — dynamic plan loading.

Plans are loaded from the database (country_plan_types table) at runtime
and cached for 5 minutes. Falls back to a static snapshot if the DB
is unavailable.

Usage:
    from app.services.charon.page_templates import get_page_prompt_addition

    prompt_addition = await get_page_prompt_addition(page_context)
    # Append to existing system prompt
"""

from __future__ import annotations

import asyncio
import logging
import time
from typing import Any

logger = logging.getLogger(__name__)

# ─── Cache ───────────────────────────────────────────────────────────────────

_cache_lock = asyncio.Lock()
_cached_plans: dict[str, dict] | None = None
_cache_timestamp: float = 0
CACHE_TTL = 300  # 5 minutes

# Static fallback used when DB is unavailable on first load
_STATIC_PLANS: dict[str, dict] = {
    "ISP-UK": {
        "price": "₦6,500/mo",
        "data": "Dedicated",
        "use_cases": "business applications, stable IP for banking, corporate VPN",
        "speed": "10Mbps guaranteed",
    },
    "ISP-US": {
        "price": "₦6,500/mo",
        "data": "Dedicated",
        "use_cases": "US-based services, American streaming, business applications",
        "speed": "10Mbps guaranteed",
    },
    "ISP-DE": {
        "price": "₦7,500/mo",
        "data": "Dedicated",
        "use_cases": "EU services, German banking, European streaming",
        "speed": "10Mbps guaranteed",
    },
    "RESI-US-20GB": {
        "price": "₦15,000/mo",
        "data": "20GB",
        "use_cases": "sneaker sites, ticket purchasing, social media management, general browsing",
        "speed": "Best effort, typically 5-20Mbps",
    },
    "RESI-UK-20GB": {
        "price": "₦15,000/mo",
        "data": "20GB",
        "use_cases": "UK streaming, British banking sites, UK-specific services",
        "speed": "Best effort, typically 5-20Mbps",
    },
    "DC-US-20GB": {
        "price": "₦8,000/mo",
        "data": "20GB",
        "use_cases": "web scraping, automation, server hosting, API calls",
        "speed": "100Mbps shared",
    },
    "DC-EU-20GB": {
        "price": "₦8,000/mo",
        "data": "20GB",
        "use_cases": "EU web scraping, European automation, server hosting",
        "speed": "100Mbps shared",
    },
}


async def _load_plans_from_db() -> dict[str, dict]:
    """Load plan details from country_plan_types table."""
    try:
        from sqlalchemy import text
        from app.database import async_session

        async with async_session() as session:
            result = await session.execute(text("""
                SELECT
                    plan_type,
                    country_code,
                    price_per_ip,
                    price_per_gb,
                    is_special,
                    enabled
                FROM country_plan_types
                WHERE enabled = true
                ORDER BY country_code, plan_type
            """))
            rows = result.fetchall()
            plans: dict[str, dict] = {}
            for row in rows:
                plan_type = (row.plan_type or "RESIDENTIAL").upper()
                country = (row.country_code or "").upper()
                code = f"{plan_type[:4]}-{country}" if country else plan_type

                price = None
                if row.price_per_ip:
                    price = f"₦{float(row.price_per_ip):,.0f}/mo per IP"
                elif row.price_per_gb:
                    price = f"₦{float(row.price_per_gb):,.0f}/mo per GB"

                data = "Dedicated" if plan_type == "ISP" else "20GB"
                if plan_type == "RESIDENTIAL":
                    data = "per GB"

                plans[code] = {
                    "price": price or "Contact us",
                    "data": data,
                    "use_cases": _use_cases_for_plan(plan_type, country),
                    "speed": _speed_for_plan(plan_type),
                }
            logger.info("Loaded %d plans from country_plan_types", len(plans))
            return plans
    except Exception as exc:
        logger.warning("Failed to load plans from DB, using static fallback: %s", exc)
        return dict(_STATIC_PLANS)


def _use_cases_for_plan(plan_type: str, country: str) -> str:
    """Return use-case text based on plan type."""
    pt = plan_type.upper()
    if pt == "ISP":
        return f"streaming, automation, stable IP for {country} services"
    elif pt == "RESIDENTIAL":
        return "sneaker sites, social media, ad verification, streaming"
    elif pt == "DATACENTER":
        return "web scraping, automation, server hosting, API calls"
    elif pt == "MOBILE":
        return "account creation, highest trust score, mobile fingerprinting"
    return "general browsing, automation"


def _speed_for_plan(plan_type: str) -> str:
    """Return speed SLA text based on plan type."""
    pt = plan_type.upper()
    if pt == "ISP":
        return "10Mbps guaranteed"
    elif pt == "RESIDENTIAL":
        return "Best effort, typically 5-20Mbps"
    elif pt == "DATACENTER":
        return "100Mbps shared"
    elif pt == "MOBILE":
        return "4G/LTE speeds"
    return "standard"


async def _get_plans() -> dict[str, dict]:
    """Return cached plan dict, refreshing from DB if stale."""
    global _cached_plans, _cache_timestamp
    now = time.monotonic()

    if _cached_plans is not None and (now - _cache_timestamp) < CACHE_TTL:
        return _cached_plans

    async with _cache_lock:
        # Double-check after acquiring lock
        if _cached_plans is not None and (now - _cache_timestamp) < CACHE_TTL:
            return _cached_plans
        _cached_plans = await _load_plans_from_db()
        _cache_timestamp = now
        return _cached_plans


def invalidate_cache() -> None:
    """Clear the plan cache (call when plans change)."""
    global _cached_plans, _cache_timestamp
    _cached_plans = None
    _cache_timestamp = 0


async def get_page_prompt_addition(page_context: dict[str, Any] | None) -> str:
    """Get the appropriate system prompt addition based on page context.

    Args:
        page_context: Dictionary containing page_type and any relevant context
                     like plan_code, post_title, etc.

    Returns:
        A string to append to the system prompt, or empty string if no
        page context is provided.
    """
    if not page_context:
        return ""

    page_type = page_context.get("page_type")

    if page_type == "pricing":
        return await _get_pricing_template()
    elif page_type == "product_detail":
        return await _get_product_detail_template(page_context)
    elif page_type == "blog_post":
        return _get_blog_post_template(page_context)
    elif page_type in ("checkout", "receipt"):
        return _get_checkout_template()

    return ""


async def _get_pricing_template() -> str:
    """System prompt addition for pricing page visitors — dynamic plans."""
    plans = await _get_plans()
    if not plans:
        return (
            "[System prompt addition for pricing page visitors]\n"
            "The customer is viewing our pricing page. Lead with plan specifics."
        )

    # Build plan listing
    lines = []
    for code, details in sorted(plans.items()):
        price = details.get("price", "Contact us")
        data = details.get("data", "")
        lines.append(f"- {code}: {price} ({data})")

    plan_listing = "\n".join(lines[:12])  # cap to keep prompt reasonable

    return (
        "[System prompt addition for pricing page visitors]\n"
        "The customer is currently viewing our pricing page. Available plans:\n"
        f"{plan_listing}\n"
        "Lead with plan specifics, not generic explanations. If they ask about speed, "
        "mention our SLA. If they ask about Nigeria compatibility, mention the Nigerian banking sites we support."
    )


async def _get_product_detail_template(page_context: dict[str, Any]) -> str:
    """System prompt addition for product detail page visitors."""
    plan_code = page_context.get("plan_code", "")
    plans = await _get_plans()
    details = plans.get(plan_code)

    if not details:
        return ""

    return (
        "[System prompt addition for product detail page]\n"
        f"Customer is viewing {plan_code}. Key facts to reference:\n"
        f"- Price: {details.get('price', 'N/A')}\n"
        f"- Data allowance: {details.get('data', 'N/A')}\n"
        f"- Use cases: {details.get('use_cases', 'general browsing')}\n"
        f"- Speed SLA: {details.get('speed', 'standard')}\n"
        'If they ask "is this good for X?", answer definitively about that plan.'
    )


def _get_blog_post_template(page_context: dict[str, Any]) -> str:
    """System prompt addition for blog post readers."""
    post_title = page_context.get("post_title", "Untitled Post")
    topics = page_context.get("topics", "general topics")

    return (
        "[System prompt addition for blog readers]\n"
        f'Customer is reading our blog post "{post_title}". This post covers: {topics}.\n'
        "Use it as the primary reference. Quote from it if relevant. "
        "Link to it if the customer asks a follow-up."
    )


def _get_checkout_template() -> str:
    """System prompt addition for checkout/receipt pages."""
    return (
        "[System prompt addition for checkout/receipt page]\n"
        "Customer is in the checkout flow or has just completed a purchase.\n"
        "- Be helpful but NOT pushy. Don't hard-sell.\n"
        "- If they have a tx_ref in context, you can look up their order.\n"
        "- If they're asking about payment, direct them to Flutterwave's support.\n"
        "- Never ask for payment details — we never store them."
    )
