{
  "name": "Credentials Delivered",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "credentials-delivered",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "webhookId": "credentials-delivered"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "order_id",
              "name": "order_id",
              "value": "={{$json.body.order_id}}"
            },
            {
              "id": "tx_ref",
              "name": "tx_ref",
              "value": "={{$json.body.tx_ref}}"
            },
            {
              "id": "phone",
              "name": "phone",
              "value": "={{$json.body.phone}}"
            },
            {
              "id": "channel",
              "name": "channel",
              "value": "={{$json.body.channel}}"
            },
            {
              "id": "username",
              "name": "styxproxy_username",
              "value": "={{$json.body.styxproxy_username}}"
            },
            {
              "id": "password",
              "name": "styxproxy_password",
              "value": "={{$json.body.styxproxy_password}}"
            },
            {
              "id": "proxy_ip",
              "name": "proxy_ip",
              "value": "={{$json.body.proxy_ip}}"
            },
            {
              "id": "proxy_port",
              "name": "proxy_port",
              "value": "={{$json.body.proxy_port}}"
            },
            {
              "id": "expires_at",
              "name": "expires_at",
              "value": "={{$json.body.expires_at}}"
            },
            {
              "id": "receipt_url",
              "name": "receipt_url",
              "value": "={{$json.body.receipt_url}}"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-payload",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.styxproxy.com/api/v1/charon/reply",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({message: \"Your proxy credentials are ready!\\n\\nProxy: \" + $json.proxy_ip + \":\" + $json.proxy_port + \"\\nUsername: \" + $json.styxproxy_username + \"\\nPassword: \" + $json.styxproxy_password + \"\\nExpires: \" + $json.expires_at, phone: $json.phone, channel: $json.channel})}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-charon",
      "name": "Call Charon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Parse Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Payload": {
      "main": [
        [
          {
            "node": "Call Charon",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true
}