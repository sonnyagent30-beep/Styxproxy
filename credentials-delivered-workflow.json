{
  "name": "Credentials Delivered",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "credentials-delivered",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "notes": "Fired by the fulfilment worker as a NOTIFICATION only. Credential delivery is unconditional email (send_order_active_email); this workflow's result is never obeyed. Provenance: this file is the credential-FREE target shape, not an export of the live workflow. Live `Sy0H7iuGMaDg1Af5` still sends the password and is fixed by devops in t_8a9c42a4; refresh from live once that lands.",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "webhookId": "credentials-delivered"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "order_id",
              "name": "order_id",
              "value": "={{$json.body.order_id}}"
            },
            {
              "id": "tx_ref",
              "name": "tx_ref",
              "value": "={{$json.body.tx_ref}}"
            },
            {
              "id": "phone",
              "name": "phone",
              "value": "={{$json.body.phone}}"
            },
            {
              "id": "channel",
              "name": "channel",
              "value": "={{$json.body.channel}}"
            },
            {
              "id": "proxy_ip",
              "name": "proxy_ip",
              "value": "={{$json.body.proxy_ip}}"
            },
            {
              "id": "proxy_port",
              "name": "proxy_port",
              "value": "={{$json.body.proxy_port}}"
            },
            {
              "id": "expires_at",
              "name": "expires_at",
              "value": "={{$json.body.expires_at}}"
            },
            {
              "id": "receipt_url",
              "name": "receipt_url",
              "value": "={{$json.body.receipt_url}}"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-payload",
      "name": "Parse Payload",
      "notes": "Deliberately does NOT map styxproxy_password or styxproxy_username. The webhook body still carries them, but nothing in this workflow needs them, so they are never pulled into the run context.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.styxproxy.com/api/v1/charon/reply",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({user_message: \"Order \" + $json.order_id + \" (\" + $json.tx_ref + \") is now active. The customer has been emailed their proxy credentials.\", customer_phone: $json.phone, channel: $json.channel})}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-charon",
      "name": "Call Charon",
      "notes": "NOT a credential channel. /charon/reply persists every message to charon_messages AND forwards it to an external LLM provider (api.longcat.ai), so it carries order context only. The backend resolves the order; the customer receives credentials by email. Do not add a password here - backend/tests/test_charon_credential_leak.py fails if you do.",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Parse Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Payload": {
      "main": [
        [
          {
            "node": "Call Charon",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true
}